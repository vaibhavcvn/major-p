# ─────────────────────────────────────────────────────────────────────────────
# Smart Ambulance — Environment configuration template
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — JWT signing secret (min 32 random characters)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_secret

# JWT token lifetime in minutes
# Default (and recommended): 1440 = 24 hours
# Reduce for higher-security deployments, increase for demo convenience
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./smart_ambulance.db
# DATABASE_URL=postgresql://user:password@localhost:5432/smart_ambulance

# CORS — comma-separated list of trusted frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Optional external services
# OSRM_BASE_URL=https://router.project-osrm.org
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
